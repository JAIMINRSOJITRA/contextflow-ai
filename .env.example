# ContextFlow AI — environment configuration
# Copy this file to .env and fill in your real API keys.
# .env is listed in .gitignore and must never be committed.

# ⚠️ SECURITY WARNING: Never commit .env file or share API keys publicly!
# ⚠️ If keys are exposed, regenerate them immediately at the provider dashboards.

# ---------------------------------------------------------------------------
# API keys
# ---------------------------------------------------------------------------
# Get a free Gemini key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get a free Groq key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Which provider to use when a /chat/ask request doesn't specify one.
# Must be "gemini" or "groq".
DEFAULT_LLM_PROVIDER=groq

# ---------------------------------------------------------------------------
# Database and file storage
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./app/db/contextflow.db
UPLOAD_FOLDER=data/uploads

# Can be a directory path (index.faiss is appended automatically)
# or the full path to the .faiss file.
VECTOR_INDEX_PATH=./data/vector_index

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# "gemini"               — uses models/text-embedding-004 via the google-genai SDK
# "sentence-transformers" — uses a local model, no API key required (default)
EMBEDDING_PROVIDER=sentence-transformers

# Only used when EMBEDDING_PROVIDER=sentence-transformers
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Retrieval tuning
# ---------------------------------------------------------------------------
# Characters per chunk (must be >= 1)
CHUNK_SIZE=500

# Characters shared between adjacent chunks (must be < CHUNK_SIZE)
CHUNK_OVERLAP=50

# How many chunks to retrieve per question
TOP_K_RESULTS=4

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Advanced RAG tuning (optional, defaults are optimized)
# ---------------------------------------------------------------------------
# Hybrid search: How many extra candidates to retrieve (multiplier * top_k)
HYBRID_SEARCH_MULTIPLIER=3

# RRF constant for rank fusion (higher = more weight to top results)
RRF_K=60

# ---------------------------------------------------------------------------
# Model configuration (optional, defaults work well)
# ---------------------------------------------------------------------------
# Gemini model name for LLM generation
GEMINI_MODEL=gemini-2.5-flash

# Groq model name for LLM generation
GROQ_MODEL=llama-3.3-70b-versatile
